# 示例配置；复制后自行在 shell 设置，不填写并提交真实密钥。
AI_CLI_WORKSPACE_ROOT=/home/yourname/projects
AI_CLI_WEB_STATE=/home/yourname/projects/.ai-cli/web
# 可选：显式选择可信用户 TOML；默认读取 ~/.config/local-ai-cli/config.toml。
# AI_CLI_CONFIG=/home/yourname/.config/local-ai-cli/config.toml
AI_CLI_PROVIDER=openai
AI_CLI_MODEL=your-api-model
AI_CLI_BASE_URL=https://api.openai.com/v1
AI_CLI_API_KEY_ENV=OPENAI_API_KEY
AI_CLI_STREAM=true
AI_CLI_MAX_WORKERS=2
AI_CLI_RUN_TIMEOUT=600
AI_CLI_APPROVAL_MODE=manual
AI_CLI_MCP=0
# 可选：启用远程语义 Embedding；未配置则使用无需模型请求的词项哈希混合检索。
# AI_CLI_EMBEDDING_MODEL=your-embedding-model
